          <property name="styleSheet">
           <string notr="true">QSpinBox {
    background-color: #0078D7;
    color: black;
    border: none;
    border-radius: 6px;
    padding: 7px 6px;
    /* Выравнивание текста по центру */
    selection-background-color: #005a9e;
}

/* Стрелки вверх/вниз сверху и снизу */
QSpinBox::up-button,
QSpinBox::down-button {
    width: 20px;
    background-color: #0078D7;
    border: none;
    border-radius: 0 6px 6px 0;
    margin: 0;
}

/* Если нужны фокус и hover у всего спинбокса */
QSpinBox:focus {
    border: 2px solid #0094ff;
}

QSpinBox:hover {
    background-color: #005a9e;
}

QSpinBox:disabled {
    background-color: #cccccc;
    color: #666666;
}

/* для стрелок в неактивном режиме */
QSpinBox:disabled::up-button,
QSpinBox:disabled::down-button {
    background-color: #cccccc;
}</string>
          </property>
